# Email Configuration for HBT Driver Application System
# Copy this file to .env.local and fill in your email credentials

# Gmail Configuration (recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Recipient Configuration
EMAIL_TO=hr@hbtinc.com

# Email Customization
EMAIL_FROM_NAME=HBT Inc. Driver Applications
EMAIL_SUBJECT=New Driver Application - {applicantName}

# Instructions:
# 1. For Gmail, you'll need to use an App Password instead of your regular password
# 2. Enable 2-factor authentication on your Gmail account
# 3. Generate an App Password: Google Account > Security > App passwords
# 4. Use the generated App Password as EMAIL_PASS
